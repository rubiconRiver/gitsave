{
  "name": "@intentional/electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && electron . --inspect",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@intentional/shared": "^0.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "electron-store": "^8.1.0",
    "menubar": "^9.5.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "app.intentional.v1",
    "productName": "Intentional",
    "directories": {
      "output": "dist-app"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  }
}